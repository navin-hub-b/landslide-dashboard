# ==============================================================================
# ESP32 Landslide Early-Warning Dashboard - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in local development or set these variables in production.
# IMPORTANT: Never commit real API keys, auth tokens, or passwords to source control.

# ------------------------------------------------------------------------------
# 1. Server & Networking
# ------------------------------------------------------------------------------
# Port for the Node.js/Express server to listen on
PORT=5000

# Allowed CORS origins (use '*' for open access, or comma-separated URLs in production)
CORS_ORIGIN=*

# Application environment ('development' | 'production' | 'test')
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Hardware API & Telemetry Ingestion
# ------------------------------------------------------------------------------
# Optional secret key required in the 'X-API-Key' HTTP header from the ESP32
# Leave blank to allow open ingestion during local prototyping
HARDWARE_API_KEY=

# Inactivity timeout (seconds) after which lack of ESP32 POST signals offline/stale
HARDWARE_STALE_SECONDS=60

# Maximum number of rolling telemetry samples stored in memory ring buffer
# (360 samples at 10-second intervals = ~1 hour of rolling history)
MAX_HISTORY=360

# ------------------------------------------------------------------------------
# 3. Monitoring Site & Hardware Setup Geolocation
# ------------------------------------------------------------------------------
# Default coordinates (WGS-84) of the hillside sensor deployment
SITE_LATITUDE=19.1334
SITE_LONGITUDE=72.9133
SITE_LABEL=IIT Bombay Hillside Station #1

# Physical IoT Hardware Deployment Node Coordinates (slope installation)
# Can also be dynamically updated via POST /api/sensor-data GPS fields or POST /api/hardware/location
HARDWARE_LATITUDE=11.5367
HARDWARE_LONGITUDE=76.1384
HARDWARE_ALTITUDE_M=820
HARDWARE_STATION_ID=WAYANAD_SLOPE_NODE_01
HARDWARE_LABEL=Wayanad Meppadi Hillside Node

# ------------------------------------------------------------------------------
# 4. Weather API (Open-Meteo)
# ------------------------------------------------------------------------------
# Upstream weather forecast API endpoint for rain accumulation & weather warnings
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Duration (in minutes) to cache weather API responses before re-querying
WEATHER_CACHE_MINUTES=15

# Interval (in minutes) for background weather polling worker
WEATHER_CHECK_INTERVAL_MINUTES=15

# Rainfall rate (mm/h in next 6h) triggering heavy rain risk addition (+3 pts)
WEATHER_HEAVY_RAIN_MM=10.0

# Rainfall rate (mm/h in next 6h) triggering moderate rain risk addition (+1 pt)
WEATHER_MODERATE_RAIN_MM=2.5

# ------------------------------------------------------------------------------
# 5. Landslide Risk Thresholds (matching Firmware Sections 6 & 10)
# ------------------------------------------------------------------------------
# Cumulative integer score needed to trigger WARNING state (Yellow LED, short beep)
RISK_THRESHOLD_WARNING=4

# Cumulative integer score needed to trigger HIGH_RISK state (Red LED, repeated beeps)
RISK_THRESHOLD_HIGH=7

# Cumulative integer score needed to trigger DANGER state (Red LED, continuous buzzer)
RISK_THRESHOLD_DANGER=10

# ------------------------------------------------------------------------------
# 6. Alert Deduplication & Cooldown
# ------------------------------------------------------------------------------
# Minimum cooldown period (minutes) between sending repeated SMS alerts for the same status level
ALERT_COOLDOWN_MINUTES=15

# ------------------------------------------------------------------------------
# 7. SMS & Emergency Notification Provider
# ------------------------------------------------------------------------------
# Active SMS driver: 'console' (prints to terminal), 'mock' (in-memory only), or 'twilio'
SMS_PROVIDER=console

# Twilio Credentials (required only when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Safety guard: set to 'true' only if you intend manual test triggers to send real SMS
ALLOW_REAL_TEST_SMS=false

# ------------------------------------------------------------------------------
# 8. Map Layers & Evacuation Routing
# ------------------------------------------------------------------------------
# OpenStreetMap or MapLibre raster/vector tile URL template
MAP_STYLE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Open Source Routing Machine (OSRM) base URL for computing walking/driving escape paths
OSRM_BASE_URL=https://router.project-osrm.org

# High-resolution satellite raster imagery tile template
SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# Designated safe evacuation zone / shelter coordinates & verification status
SAFE_DEST_LATITUDE=19.1360
SAFE_DEST_LONGITUDE=72.9160
SAFE_DEST_LABEL=Campus Evacuation Center / Safe Shelter
SAFE_DEST_VERIFIED=true
